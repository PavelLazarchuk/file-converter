{
    "name": "file-converter",
    "version": "1.0.0",
    "description": "file-converter-app",
    "private": true,
    "sideEffects": false,
    "scripts": {
        "predev": "node scripts/copy-codecs.mjs",
        "dev": "next dev",
        "prebuild": "node scripts/copy-codecs.mjs",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "i18n:sync": "node scripts/i18n-sync.mjs",
        "i18n:check": "node scripts/i18n-sync.mjs --check",
        "typecheck": "next typegen && tsc --noEmit",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "codecs": "node scripts/copy-codecs.mjs",
        "codecs:check": "node scripts/copy-codecs.mjs --check"
    },
    "homepage": "https://file-converter-mu-seven.vercel.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/PavelLazarchuk/file-converter.git"
    },
    "author": "Pavel Lazarchuk",
    "license": "MIT",
    "browserslist": [
        ">0.3%",
        "not ie 11",
        "not dead",
        "not op_mini all"
    ],
    "dependencies": {
        "@hookform/resolvers": "^5.7.1",
        "@jsquash/jpeg": "^1.6.0",
        "@jsquash/png": "^3.1.1",
        "@jsquash/webp": "^1.5.0",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.31.0",
        "next": "16.2.10",
        "next-intl": "^4.13.7",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^6.3.289",
        "radix-ui": "^1.6.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "^7.85.0",
        "sharp": "^0.35.3",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.2.10",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "shadcn": "^4.17.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    }
